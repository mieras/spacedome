# Kopieer naar .env en vul in. Nooit .env committen.
# PUBLIC_ = openbaar (komt in de browser). Tokens nooit met PUBLIC_.

# Sanity. Project en dataset zijn openbaar (staan ook als terugval in de config).
PUBLIC_SANITY_PROJECT_ID=6fcexd1b
PUBLIC_SANITY_DATASET=production
# Geheim. Rol Viewer. Voor drafts in de Presentation tool; ondertekent ook de preview-cookie.
SANITY_API_READ_TOKEN=
# Geheim. Zelf kiezen; zelfde waarde in de Sanity-webhook naar /api/revalidate. Alleen op Netlify nodig.
SANITY_WEBHOOK_SECRET=
# Geheim. Alleen lokaal, voor scripts/migrate-to-sanity.ts. Intrekken na de migratie.
SANITY_API_WRITE_TOKEN=

# Bunny Stream (video). Dashboard → Stream → je library → API.
BUNNY_STREAM_LIBRARY_ID=
# Hostnaam van de CDN, bv. vz-12345678-abc.b-cdn.net (zonder https://)
BUNNY_STREAM_CDN_HOSTNAME=
# Geheim. Alleen lokaal nodig (importscript), niet op Netlify.
BUNNY_STREAM_API_KEY=
# Geheim. Voor getekende video-URL's; op Netlify zetten zodra die aan staan.
BUNNY_STREAM_TOKEN_KEY=

# STACK (bron van de opnames). Alleen-lezen share-link van de map Recordings.
STACK_SHARE_URL=
