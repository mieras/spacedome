---
// Zelf gehost (geen verzoeken naar Google, AVG).
import '@fontsource-variable/stack-sans-notch';
import '@fontsource-variable/stack-sans-headline';
import '@fontsource-variable/stack-sans-text';
import '@fontsource-variable/unbounded'; // alleen het logo
import '../styles/index.scss';

import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageProgress from '../components/PageProgress.astro';
import Player from '../components/Player.astro';
import SiteMeta from '../components/SiteMeta.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { t } from '../i18n/ui';
import VisualEditing from '../lib/sanity/VisualEditing';
import { settings } from '../settings';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  isHome?: boolean;
  noindex?: boolean;
  jsonLd?: object[];
}

const props = Astro.props;
const visualEditing = Astro.locals.visualEditing;
---

<!doctype html>
<html lang={settings.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ThemeScript />
    <SiteMeta {...props} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f0f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#110c22" media="(prefers-color-scheme: dark)" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <PageProgress />
    <Header />
    <main id="main" data-page tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Player />
    {visualEditing && <VisualEditing client:only="react" />}
    {
      visualEditing && (
        <script is:inline>
          // Alleen in de Presentation tool: elke klik een volledige page load i.p.v. een ClientRouter-swap.
          // De router haalt pagina's op via fetch (Sec-Fetch-Dest: empty), dus zonder Visual Editing.
          // Capture-fase: dit draait vóór de click-handler van de router.
          document.addEventListener('click', (event) => {
            const link = event.target instanceof Element && event.target.closest('a[href]');
            if (link) link.setAttribute('data-astro-reload', '');
          }, true);
        </script>
      )
    }
    <div class="toast" role="status" aria-live="polite" data-toast transition:persist="toast"></div>
    <script>
      import '../scripts/share';
      import '../scripts/reveal';
      import '../scripts/button-flair';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
