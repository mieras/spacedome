---
// Zelf gehost (geen verzoeken naar Google, AVG). Big Shoulders met opsz-as voor optische maten.
import '@fontsource-variable/big-shoulders/opsz.css';
import '@fontsource-variable/funnel-sans';
import '@fontsource-variable/unbounded'; // alleen het logo
import '../styles/index.scss';

import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageProgress from '../components/PageProgress.astro';
import Player from '../components/Player.astro';
import SiteMeta from '../components/SiteMeta.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { t } from '../i18n/ui';
import { settings } from '../settings';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  isHome?: boolean;
  noindex?: boolean;
  jsonLd?: object[];
}

const props = Astro.props;
---

<!doctype html>
<html lang={settings.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <ThemeScript />
    <SiteMeta {...props} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f0f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#110c22" media="(prefers-color-scheme: dark)" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <PageProgress />
    <Header />
    <main id="main" data-page tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Player />
    <!-- Filter voor het smear-effect op titels en footerlinks (src/scripts/smear.ts). -->
    <svg class="sd-defs" aria-hidden="true" focusable="false" width="0" height="0">
      <filter id="sd-smear" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceGraphic" stdDeviation="0 0" result="blur" />
        <feOffset in="blur" dx="0" dy="0" result="streak" />
        <feMerge>
          <feMergeNode in="streak" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </svg>
    <div class="toast" role="status" aria-live="polite" data-toast transition:persist="toast"></div>
    <script>
      import '../scripts/share';
      import '../scripts/reveal';
      import '../scripts/smear';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
