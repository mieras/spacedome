---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import CoverArt from '../../components/CoverArt.astro';
import DjAvatar from '../../components/DjAvatar.astro';
import PlayButton from '../../components/PlayButton.astro';
import QueueButton from '../../components/QueueButton.astro';
import SetCarousel from '../../components/SetCarousel.astro';
import ShareButton from '../../components/ShareButton.astro';
import Tracklist from '../../components/Tracklist.astro';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { djHref, eventHref, genreHref, getLibrary, setHref, setStill, suggestionsFor, toPlayerItem, type SetEntry } from '../../lib/content';
import { formatDate, formatDuration, joinNames } from '../../lib/format';

export async function getStaticPaths() {
  const { sets } = await getLibrary();
  return sets.map((set) => ({ params: { id: set.id }, props: { set } }));
}

const { set } = Astro.props as { set: SetEntry };
const lib = await getLibrary();
const item = await toPlayerItem(set, lib);
const djs = lib.djsOf(set);
const genres = lib.genresOf(set);
const event = lib.eventOf(set);
const suggestions = suggestionsFor(set, lib, 10);
const { Content } = await render(set);
const duration = formatDuration(set.data.video.duration);
const still = setStill(set);
// Alleen een eigen poster als OG-beeld: crawlers sturen geen Referer, dus Bunny zou ze weigeren.
const ogImage = set.data.poster ? (await getImage({ src: set.data.poster, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const hasText = !!set.body?.trim();
const hasTracks = set.data.tracklist.length > 0;
const description = `${set.data.title} by ${joinNames(djs.map((d) => d.data.name))}. ${set.body?.split('\n').find(Boolean) ?? ''}`;
---

<BaseLayout title={`${set.data.title} – ${joinNames(djs.map((d) => d.data.name))}`} description={description} image={ogImage} type="video.other">
  <article class="set">
    <!-- Hero: video en info naast elkaar op desktop, onder elkaar op mobiel. -->
    <div class="set__hero wrapper">
      <div class="stage" data-player-stage={set.id}>
        <CoverArt seed={set.id} image={still} alt={set.data.posterAlt ?? ''} ratio="16/9" eager sizes="(min-width: 64rem) 62vw, 100vw" />
        <PlayButton item={item} size="lg" useUrlTime class="stage__play" />
      </div>

      <div class="set__info">
        <header class="set__head">
          <p class="meta">
            <time datetime={set.data.date.toISOString().slice(0, 10)}>{formatDate(set.data.date)}</time>
            {duration && <> · {duration}</>}
            {' · '}
            {event ? <a href={eventHref(event.id)}>{t('set.recordedAt')} {event.data.title} @ {event.data.venue.name}</a> : t('set.standalone')}
          </p>
          <h1 class="set__title">{set.data.title}</h1>
          <ul class="set__djs" role="list">
            {
              djs.map((dj) => (
                <li>
                  <a href={djHref(dj.id)}>
                    <DjAvatar dj={dj} size="2.5rem" />
                    <span>{dj.data.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="set__actions">
            <PlayButton item={item} label={t('set.play')} size="sm" useUrlTime />
            <QueueButton item={item} />
            <ShareButton url={setHref(set.id)} title={set.data.title} />
          </div>
          {
            genres.length > 0 && (
              <ul class="chips" role="list" aria-label={t('nav.genres')}>
                {genres.map((g) => (
                  <li>
                    <a class="chip" href={genreHref(g.id)}>
                      {g.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        {
          /* Beschrijving en tracklist. Met JS (sd-tabs) als tabs; zonder JS gewoon onder elkaar met koppen. */
          (hasText || hasTracks) && (
            <sd-tabs class="set__tabs">
              {hasText && hasTracks && (
                <div class="tabs__list" role="tablist" aria-label={set.data.title} data-tabs-list hidden>
                  <button type="button" role="tab" class="tabs__tab" id="tab-about" aria-controls="panel-about" aria-selected="true">
                    {t('set.about')}
                  </button>
                  <button type="button" role="tab" class="tabs__tab" id="tab-tracklist" aria-controls="panel-tracklist" aria-selected="false" tabindex="-1">
                    {t('set.tracklist')} <span class="tabs__count">{set.data.tracklist.length}</span>
                  </button>
                </div>
              )}
              {hasText && (
                <section class="tabs__panel" id="panel-about" aria-labelledby="about-title">
                  <h2 id="about-title" class="set__subtitle" data-tabs-heading>{t('set.about')}</h2>
                  <div class="prose set__text">
                    <Content />
                  </div>
                </section>
              )}
              {hasTracks && (
                <section class="tabs__panel" id="panel-tracklist" aria-labelledby="tracklist-title">
                  <h2 id="tracklist-title" class="set__subtitle" data-tabs-heading>{t('set.tracklist')}</h2>
                  <Tracklist tracks={set.data.tracklist} />
                </section>
              )}
            </sd-tabs>
          )
        }
      </div>
    </div>

    {
      suggestions.length > 0 && (
        <section class="section wrapper" aria-labelledby="more-title">
          <SetCarousel sets={suggestions} lib={lib} title={t('set.more')} id="more-title" />
        </section>
      )
    }
  </article>
</BaseLayout>

<script>
  import '../../scripts/tabs';
</script>

<style>
  .set__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    padding-block: var(--space-m) var(--space-xl);
  }
  /* Desktop: video links (ruim), info rechts. */
  @media (min-width: 64rem) {
    .set__hero { grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); align-items: start; gap: var(--space-l-xl); }
  }

  /* 16:9, maar nooit hoger dan het scherm min header en playerbalk. */
  .stage {
    position: relative;
    inline-size: 100%;
    max-inline-size: calc((100svh - var(--header-h) - var(--player-h) - var(--space-l)) * 16 / 9);
    margin-inline: auto;
  }
  .stage::before {
    content: '';
    position: absolute;
    inset: 10% 5% -12%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--color-glow), transparent);
    filter: blur(20px);
  }
  :global(.stage__play) { position: absolute; inset: 50% auto auto 50%; translate: -50% -50%; z-index: 3; }
  /* Desktop: video blijft staan terwijl je door beschrijving/tracklist scrolt. Aan het eind van
     de hero scrolt hij mee weg; de player maakt er dan een mini-video van (IntersectionObserver). */
  @media (min-width: 64rem) {
    .stage { position: sticky; inset-block-start: calc(var(--header-h) + var(--space-s)); }
  }
  /* Speelt deze set en ligt de video eroverheen: cover en knop onzichtbaar, ruimte blijft. */
  .stage[data-player-docked] > :global(*) { visibility: hidden; }

  .set__info { display: grid; gap: var(--space-l); align-content: start; container-type: inline-size; min-inline-size: 0; }
  .set__head { display: grid; gap: var(--space-s); align-content: start; }
  .set__head .meta a { color: inherit; }
  /* Schaalt met de kolom: groot op mobiel en in de brede kolom, kleiner naast de video. */
  .set__title { font-size: min(var(--step-6), 12cqi); text-transform: uppercase; letter-spacing: -0.035em; line-height: 0.98; }
  .set__djs { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-s); }
  .set__djs a { display: inline-flex; align-items: center; gap: var(--space-2xs); font-size: var(--step-1); font-weight: 600; text-decoration: none; }
  .set__djs a:hover span { text-decoration: underline; }
  .set__actions { display: flex; flex-wrap: wrap; gap: var(--space-2xs); }
  .set__text { font-size: var(--step-0); line-height: var(--leading-snug); }
  .set__subtitle { font-size: var(--step-1); text-transform: uppercase; letter-spacing: 0; margin-block-end: var(--space-2xs); }

  /* Tabs (zie src/scripts/tabs.ts). Zonder JS: panelen onder elkaar met koppen. */
  .set__tabs { display: grid; gap: var(--space-l); }
  .set__tabs[data-ready] { gap: var(--space-s); }
  .tabs__list {
    display: flex;
    gap: var(--space-s);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .tabs__list[hidden] { display: none; }
  .tabs__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5ch;
    min-block-size: 2.75rem;
    margin-block-end: calc(var(--border-width) * -1);
    padding: 0 var(--space-3xs);
    border: 0;
    border-block-end: 2px solid transparent;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-meta);
    font-size: var(--step--1);
    cursor: pointer;
  }
  .tabs__tab:hover { color: var(--color-fg); }
  .tabs__tab[aria-selected='true'] { color: var(--color-fg); border-block-end-color: var(--color-accent); }
  .tabs__tab:focus-visible { outline-offset: -2px; }
  .tabs__count {
    min-inline-size: 1.6em;
    padding: 0.05em 0.45em;
    border-radius: var(--radius-round);
    background: color-mix(in oklch, currentColor 12%, transparent);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    text-align: center;
  }
  .tabs__panel:focus-visible { outline-offset: var(--space-2xs); }
</style>
