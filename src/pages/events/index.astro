---
import EventCard from '../../components/EventCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLibrary, isUpcoming, setsByEvent } from '../../lib/content';
import { settings } from '../../settings';

const lib = await getLibrary();
const upcoming = lib.events.filter((e) => isUpcoming(e)).reverse();
const past = lib.events.filter((e) => !isUpcoming(e));
---

<BaseLayout title={t('events.title')} description="Space Dome nights: upcoming dates and the archive of past nights, with the sets recorded there.">
  <PageHeader title={t('events.title')} lead="An intimate space satellite for the LA beat scene. From afternoon to midnight, no rush." />

  <section class="wrapper section" aria-labelledby="upcoming-title">
    <div class="section-head"><h2 id="upcoming-title">{t('events.upcoming')}</h2></div>
    {
      upcoming.length ? (
        <ul role="list">
          {upcoming.map((e) => (
            <li>
              <EventCard event={e} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">
          {t('events.tba')}{' '}
          <a href={settings.socials[0]?.url} rel="noopener" target="_blank">
            {settings.socials[0]?.handle}
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </p>
      )
    }
  </section>

  <section class="wrapper section" aria-labelledby="past-title">
    <div class="section-head"><h2 id="past-title">{t('events.past')}</h2></div>
    <ul role="list">
      {
        past.map((e) => (
          <li>
            <EventCard event={e} setCount={setsByEvent(lib, e.id).length} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
