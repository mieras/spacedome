---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import CoverArt from '../../components/CoverArt.astro';
import DjAvatar from '../../components/DjAvatar.astro';
import Icon from '../../components/Icon.astro';
import SetGrid from '../../components/SetGrid.astro';
import { t } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { djHref, eventHref, getLibrary, isUpcoming, setsByEvent, type DjEntry, type EventEntry } from '../../lib/content';
import { formatDate, formatDateLong, formatTime } from '../../lib/format';
import { musicEventJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const { events } = await getLibrary();
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props as { event: EventEntry };
const lib = await getLibrary();
const { title, start, end, venue, poster, posterAlt, ticketUrl } = event.data;
const sets = setsByEvent(lib, event.id);
const upcoming = isUpcoming(event);
const { Content } = await render(event);

// Line-up: aangekondigd + iedereen die er een set speelde.
const lineupMap = new Map<string, DjEntry>();
for (const r of event.data.lineup) {
  const dj = lib.djMap.get(r.id);
  if (dj) lineupMap.set(dj.id, dj);
}
for (const s of sets) for (const dj of lib.djsOf(s)) lineupMap.set(dj.id, dj);
const lineup = [...lineupMap.values()];

const fullTitle = `${title} @ ${venue.name}`;
const ogImage = poster ? (await getImage({ src: poster, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const jsonLd = musicEventJsonLd(
  {
    name: fullTitle,
    url: new URL(eventHref(event.id), Astro.site).href,
    start,
    end,
    venue,
    performers: lineup.map((d) => d.data.name),
    description: event.body?.trim().split('\n')[0],
    image: ogImage && new URL(ogImage, Astro.site).href,
    ticketUrl,
  },
  Astro.site!,
);
---

<BaseLayout title={`${fullTitle}, ${formatDate(start)}`} description={event.body?.trim().split('\n')[0]} image={ogImage} jsonLd={[jsonLd]}>
  <article>
    <header class="event-head wrapper">
      <CoverArt seed={`event-${event.id}`} image={poster} alt={posterAlt ?? ''} ratio="4/5" eager sizes="(min-width: 56rem) 35vw, 100vw" class="event-head__poster" />
      <div class="event-head__text">
        <p class="event-head__date">
          <time datetime={start.toISOString()}>
            <span aria-hidden="true">{formatDate(start)}</span>
            <span class="visually-hidden">{formatDateLong(start)}</span>
          </time>
        </p>
        <h1>{title}</h1>
        <dl class="event-facts">
          <div>
            <dt class="meta">{t('events.venue')}</dt>
            <dd>
              {venue.url ? <a href={venue.url} rel="noopener" target="_blank">{venue.name}<span class="visually-hidden"> (opens in a new tab)</span></a> : venue.name}, {venue.city}
            </dd>
          </div>
          <div>
            <dt class="meta">Time</dt>
            <dd>
              {formatDateLong(start)}, {formatTime(start)}
              {end && `–${formatTime(end)}`}
            </dd>
          </div>
        </dl>
        {
          upcoming && ticketUrl && (
            <p>
              <a class="button button--primary" href={ticketUrl} rel="noopener" target="_blank">
                {t('events.tickets')} <Icon name="external" />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </p>
          )
        }
        <div class="prose"><Content /></div>
        {
          lineup.length > 0 && (
            <div class="lineup">
              <h2 class="meta">{t('events.lineup')}</h2>
              <ul role="list">
                {lineup.map((dj) => (
                  <li>
                    <a href={djHref(dj.id)}>
                      <DjAvatar dj={dj} size="2.75rem" />
                      <span>{dj.data.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </header>

    {
      sets.length > 0 && (
        <section class="wrapper section" aria-labelledby="event-sets">
          <div class="section-head">
            <h2 id="event-sets">{t('events.sets')}</h2>
            <span class="meta">
              {sets.length} {t('sets.count')}
            </span>
          </div>
          <SetGrid sets={sets} lib={lib} />
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .event-head {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: minmax(0, 1fr);
    padding-block: var(--space-xl) var(--space-l);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .event-head { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
    .event-head :global(.event-head__poster) { position: sticky; inset-block-start: calc(var(--header-h) + var(--space-s)); }
  }
  .event-head__text { display: grid; gap: var(--space-s); container-type: inline-size; }
  .event-head__date {
    font-family: var(--font-display);
    font-weight: 800;
    /* "30.07.2026" is ±6,7× de lettergrootte breed: nooit breder dan de kolom. */
    font-size: min(var(--step-5), 11cqi);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--color-accent);
  }
  .event-head h1 { font-size: var(--step-4); text-transform: uppercase; }
  .event-facts { display: grid; gap: var(--space-xs); }
  .event-facts dd { font-size: var(--step-1); }
  .lineup { display: grid; gap: var(--space-2xs); }
  .lineup ul { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-m); }
  .lineup a { display: inline-flex; align-items: center; gap: var(--space-2xs); font-weight: 600; text-decoration: none; }
  .lineup a:hover span { text-decoration: underline; }
</style>
