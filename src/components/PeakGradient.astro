---
/*
 * Peak gradient: een zachte regenboog van geblurde kolommen die uit de vloer oprijst, het hoogst
 * in het midden. Naar het idee van design.how/vault#peak-gradient (MIT), in Space Dome-kleuren.
 *
 * Instellingen en paletten: src/lib/peak.ts (de footer gebruikt PEAK_FOOTER; uitproberen op /brand#peak).
 *
 * Hoe het werkt: BARS rechthoeken naast elkaar in één SVG, elk 1.23× zo breed als de stap zodat ze
 * overlappen. Allemaal dezelfde verticale gradient (objectBoundingBox: elke kolom draagt de hele
 * regenboog over zijn eigen hoogte) en een gaussian blur, zodat ze samensmelten tot één vlak. De
 * laatste stop is transparant, dus de toppen lossen op. Hoogte valt vanuit het midden af met
 * 1 - t^1.24 (vlakker dan een cosinus, meer piramide).
 *
 * Oprijzen: alleen een transform (scaleY 0 → 1 vanaf de onderkant), gekoppeld aan het scrollen via
 * een scroll-driven animation (view timeline). Hij groeit mee terwijl de footer in beeld schuift en
 * zakt weer weg als je terug omhoog scrollt; volledig opgerezen zodra hij helemaal in beeld is.
 * Geen JS. Browsers zonder scroll-driven animations (Firefox nu nog) en prefers-reduced-motion:
 * hij staat er gewoon.
 */
import { PEAK_FOOTER, PEAK_H, PEAK_W, peakSvg, type PeakOptions } from '../lib/peak';

interface Props extends Partial<PeakOptions> {
  /** Uniek per instantie op een pagina (gradient- en filter-id's). */
  id?: string;
  class?: string;
  /** Niet aan het scrollen koppelen (preview op /brand). */
  still?: boolean;
}

const { id = 'peak', class: className, still = false, ...overrides } = Astro.props;
const options = { ...PEAK_FOOTER, ...overrides };
---

<div class:list={['peak', className]} aria-hidden="true" data-still={still || undefined}>
  <svg viewBox={`0 0 ${PEAK_W} ${PEAK_H}`} preserveAspectRatio="none" focusable="false" data-peak-svg={id} set:html={peakSvg(id, options)} />
</div>

<style>
  .peak {
    position: relative;
    overflow: hidden;
    pointer-events: none;
  }
  .peak svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    transform-origin: 50% 100%;
  }
  /* Scroll-gekoppeld: de timeline hangt aan de container (niet aan de svg, die schaalt zelf). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .peak { view-timeline: --peak block; }
      .peak svg {
        animation: peak-rise linear both;
        animation-timeline: --peak;
        animation-range: entry 0% entry 100%;
      }
    }
  }
  .peak[data-still] svg { animation: none; }
  /* Zachte ease-out in de keyframes zelf: scrollen is lineair, zo voelt het als oprijzen. */
  @keyframes peak-rise {
    from { transform: scaleY(0); animation-timing-function: cubic-bezier(0.33, 1, 0.68, 1); }
    to { transform: scaleY(1); }
  }
</style>
