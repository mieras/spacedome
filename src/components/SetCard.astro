---
/*
 * Kaart van een set: cover (link) met play- en wachtrijknop erover, titel, dj's en datum.
 * De cover-link is een dubbele van de titel-link en daarom uit de tabvolgorde gehaald.
 */
import { formatDate, formatDuration } from '../lib/format';
import { djHref, setHref, setStill, toPlayerItem, type Library, type SetEntry } from '../lib/content';
import CoverArt from './CoverArt.astro';
import PlayButton from './PlayButton.astro';
import QueueButton from './QueueButton.astro';

interface Props {
  set: SetEntry;
  lib: Library;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { set, lib, headingLevel: Heading = 'h3', eager = false } = Astro.props;
const item = await toPlayerItem(set, lib);
const djs = lib.djsOf(set);
const event = lib.eventOf(set);
const href = setHref(set.id);
const duration = formatDuration(set.data.video.duration);
---

<article class="set-card">
  <div class="set-card__media">
    <a href={href} tabindex="-1" aria-hidden="true" class="set-card__cover">
      <CoverArt seed={set.id} image={setStill(set)} alt="" eager={eager} />
    </a>
    <PlayButton item={item} class="set-card__play" />
    <QueueButton item={item} variant="icon" class="set-card__queue" />
    {duration && <span class="set-card__duration">{duration}</span>}
  </div>
  <div class="set-card__body">
    <p class="meta">
      <time datetime={set.data.date.toISOString().slice(0, 10)}>{formatDate(set.data.date)}</time>
      {event && <span> · {event.data.venue.name}</span>}
    </p>
    <Heading class="set-card__title"><a href={href}>{set.data.title}</a></Heading>
    <p class="set-card__djs">
      {
        djs.map((dj, i) => (
          <>
            {i > 0 && (i === djs.length - 1 ? ' & ' : ', ')}
            <a href={djHref(dj.id)}>{dj.data.name}</a>
          </>
        ))
      }
    </p>
  </div>
</article>

<style>
  .set-card { display: grid; gap: var(--space-xs); align-content: start; }

  .set-card__media { position: relative; }
  .set-card__cover { display: block; border-radius: var(--radius-m); overflow: hidden; }
  .set-card__cover :global(.art) { transition: scale var(--dur-slow) var(--ease-out); }

  :global(.set-card__play), :global(.set-card__queue) {
    position: absolute;
    z-index: 3;
    transition: opacity var(--dur) var(--ease-out), translate var(--dur) var(--ease-out), scale var(--dur) var(--ease-out);
  }
  :global(.set-card__play) { inset-block-end: var(--space-xs); inset-inline-start: var(--space-xs); }
  :global(.set-card__queue) {
    inset-block-start: var(--space-2xs);
    inset-inline-end: var(--space-2xs);
    color: oklch(97% 0.01 330);
    background: oklch(15% 0.045 292 / 0.55);
    backdrop-filter: blur(6px);
  }
  :global(.set-card__queue):hover { background: oklch(15% 0.045 292 / 0.8); }

  .set-card__duration {
    position: absolute;
    z-index: 3;
    inset-block-end: var(--space-xs);
    inset-inline-end: var(--space-xs);
    padding: 0.1em 0.6em;
    border-radius: var(--radius-round);
    background: oklch(15% 0.045 292 / 0.6);
    color: oklch(97% 0.01 330);
    font-size: var(--step--2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    backdrop-filter: blur(6px);
  }

  /* Op apparaten met hover: knoppen verschijnen bij hover of focus, en blijven als de set speelt. */
  @media (hover: hover) {
    :global(.set-card__play):not([data-state='playing'], [data-state='paused']),
    :global(.set-card__queue):not([aria-pressed='true']) { opacity: 0; translate: 0 0.35rem; }
    .set-card:hover :global(.set-card__play),
    .set-card:hover :global(.set-card__queue),
    .set-card:focus-within :global(.set-card__play),
    .set-card:focus-within :global(.set-card__queue) { opacity: 1; translate: 0 0; }
    .set-card:hover .set-card__cover :global(.art) { scale: 1.03; }
  }

  .set-card__body { display: grid; gap: var(--space-3xs); }
  .set-card__title { font-size: var(--step-1); line-height: var(--leading-snug); }
  .set-card__title a { text-decoration: none; }
  .set-card__title a:hover { text-decoration: underline; }
  .set-card__djs { color: var(--color-muted); }
  .set-card__djs a { text-decoration: none; }
  .set-card__djs a:hover { color: var(--color-fg); text-decoration: underline; }
</style>
