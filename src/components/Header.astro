---
import { t } from '../i18n/ui';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const nav = [
  { href: '/sets', label: t('nav.sets') },
  { href: '/djs', label: t('nav.djs') },
  { href: '/events', label: t('nav.events') },
  { href: '/about', label: t('nav.about') },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="site-header__inner wrapper">
    <a href="/" class="site-header__home" aria-label="Space Dome, home">
      <Logo id="header" />
    </a>
    <nav aria-label={t('nav.label')} class="site-nav">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    view-transition-name: site-header;
    background: color-mix(in oklch, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    border-block-end: var(--border-width) solid color-mix(in oklch, var(--color-line) 60%, transparent);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-block-size: var(--header-h);
    padding-block: var(--space-3xs);
  }
  .site-header__home { display: block; border-radius: 50%; --logo-size: 3.25rem; }
  .site-header__home :global(.logo) { transition: rotate var(--dur-slow) var(--ease-out); }
  .site-header__home:hover :global(.logo) { rotate: -8deg; }

  .site-nav { margin-inline-start: auto; }
  .site-nav ul { display: flex; gap: clamp(0.25rem, 1.5vw, 1.5rem); }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: var(--space-3xs);
    font-weight: 600;
    font-size: var(--step--1);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    text-decoration: none;
    text-underline-offset: 0.45em;
  }
  .site-nav a:hover { text-decoration: underline; }
  .site-nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--color-accent); }

  @media (max-width: 30rem) {
    .site-header__home { --logo-size: 2.75rem; }
    .site-nav ul { gap: 0; }
    .site-header :global(.theme-toggle [data-theme-label]) { display: none; }
  }
</style>
