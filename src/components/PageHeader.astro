---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}
const { title, eyebrow, lead } = Astro.props;
---

<header class="page-header wrapper">
  {eyebrow && <p class="meta">{eyebrow}</p>}
  <h1>{title}</h1>
  {lead && <p class="lead muted">{lead}</p>}
  <slot />
</header>

<style>
  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs);
    padding-block: var(--space-xl) var(--space-l);
  }
  .page-header h1 { font-size: min(var(--step-7), 14vw); text-transform: uppercase; line-height: 0.92; }
  @media (min-width: 48rem) {
    .page-header h1 { font-size: var(--step-8); }
  }
</style>
