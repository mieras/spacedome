---
/*
 * Footer: merk, Explore (met aantallen), de meest gespeelde genres en socials.
 * Desktop vier kolommen (merk breder), tablet en mobiel twee kolommen met het merk erboven.
 */
import { t } from '../i18n/ui';
import { genreHref, getLibrary, setsByGenre } from '../lib/content';
import { settings } from '../settings';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import PeakGradient from './PeakGradient.astro';

const lib = await getLibrary();
const explore = [
  { href: '/sets', label: t('nav.sets'), count: lib.sets.length },
  { href: '/djs', label: t('nav.djs'), count: lib.djs.length },
  { href: '/genres', label: t('nav.genres'), count: lib.genres.length },
  { href: '/events', label: t('nav.events'), count: lib.events.length },
  { href: '/about', label: t('nav.about') },
];
// Genres met de meeste sets eerst; lege genres niet.
const topGenres = lib.genres
  .map((genre) => ({ genre, count: setsByGenre(lib, genre.id).length }))
  .filter((g) => g.count > 0)
  .sort((a, b) => b.count - a.count || a.genre.data.title.localeCompare(b.genre.data.title))
  .slice(0, 6);
---

<footer class="site-footer">
  <div class="wrapper site-footer__inner">
    <div class="site-footer__brand">
      <Logo id="footer" />
      <p class="lead">{settings.tagline}</p>
    </div>

    <nav aria-labelledby="footer-explore" class="site-footer__nav">
      <h2 id="footer-explore" class="meta">{t('footer.explore')}</h2>
      <ul role="list">
        {
          explore.map((l) => (
            <li>
              <a href={l.href}>
                {l.label}
                {l.count !== undefined && <span class="badge">{l.count}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      topGenres.length > 0 && (
        <nav aria-labelledby="footer-genres" class="site-footer__nav">
          <h2 id="footer-genres" class="meta">{t('nav.genres')}</h2>
          <ul role="list">
            {topGenres.map(({ genre, count }) => (
              <li>
                <a href={genreHref(genre.id)}>
                  {genre.data.title}
                  <span class="badge">
                    {count}
                    <span class="visually-hidden"> sets</span>
                  </span>
                </a>
              </li>
            ))}
            <li>
              <a href="/genres" class="site-footer__more">
                {t('footer.allGenres')} <Icon name="arrow" />
              </a>
            </li>
          </ul>
        </nav>
      )
    }

    <nav aria-labelledby="footer-follow" class="site-footer__nav">
      <h2 id="footer-follow" class="meta">{t('footer.follow')}</h2>
      <ul role="list">
        {
          settings.socials.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label} <span class="muted">{s.handle}</span>
                <Icon name="external" />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

  </div>

  <!-- Peak gradient onderaan, met het copyright op de donkere vloer. -->
  <div class="site-footer__peak">
    <PeakGradient class="site-footer__glow" />
    <p class="site-footer__small meta wrapper">© {new Date().getFullYear()} {settings.siteName}</p>
  </div>

</footer>


<style>
  .site-footer {
    margin-block-start: var(--space-2xl);
    padding-block-start: var(--space-xl);
    border-block-start: var(--border-width) solid var(--color-line);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--space-m);
    align-items: start;
  }
  .site-footer__brand { grid-column: 1 / -1; }
  @media (min-width: 40rem) {
    .site-footer__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 56rem) {
    .site-footer__inner { grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); }
    .site-footer__brand { grid-column: auto; }
  }
  .site-footer__brand { display: grid; gap: var(--space-s); align-content: start; --logo-size: clamp(6rem, 12vw, 9rem); }
  .site-footer__brand .lead { max-inline-size: 28ch; font-size: var(--step-0); color: var(--color-muted); }
  .site-footer__nav { display: grid; gap: var(--space-2xs); min-inline-size: 0; }
  .site-footer__nav ul { display: grid; gap: var(--space-3xs); }
  /* Links in mono-kapitalen (systeemfont, geen extra download). */
  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.75ch;
    min-block-size: 2rem;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .site-footer__nav a:hover { color: var(--color-accent); }
  .site-footer__nav :global(.icon) { inline-size: 1em; block-size: 1em; flex: none; }
  .site-footer__more { color: var(--color-muted); }
  .site-footer__nav .muted { text-transform: none; }

  /* Peak: de vloer is in beide thema's donker, dus het copyright is daar altijd licht. */
  .site-footer__peak {
    position: relative;
    display: grid;
    align-items: end;
    block-size: clamp(11rem, 34vw, 26rem);
    margin-block-start: var(--space-xl);
  }
  .site-footer__peak > :global(*) { grid-area: 1 / 1; }
  :global(.site-footer__glow) { block-size: 100%; }
  .site-footer__small {
    position: relative;
    padding-block: var(--space-s);
    color: oklch(96% 0.02 300);
  }

</style>
