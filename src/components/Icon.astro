---
/*
 * Iconen (24×24, lijn 1.75). Altijd aria-hidden: de knop eromheen draagt het label.
 */
interface Props {
  name: keyof typeof icons;
  class?: string;
}

const icons = {
  play: { fill: true, d: 'M8 5.2v13.6a.6.6 0 0 0 .9.5l10.6-6.8a.6.6 0 0 0 0-1L8.9 4.7a.6.6 0 0 0-.9.5z' },
  pause: { fill: true, d: 'M7 5h3.5v14H7zM13.5 5H17v14h-3.5z' },
  plus: { d: 'M12 5v14M5 12h14' },
  check: { d: 'M5 12.5l4.5 4.5L19 7' },
  share: { d: 'M12 15V3M7.5 7.5 12 3l4.5 4.5M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7' },
  close: { d: 'M6 6l12 12M18 6 6 18' },
  queue: { d: 'M4 6h13M4 12h13M4 18h8M17.5 15v6M14.5 18h6' },
  back: { d: 'M4 12a8 8 0 1 0 2.4-5.7L4 8.5M4 4v4.5h4.5' },
  forward: { d: 'M20 12a8 8 0 1 1-2.4-5.7L20 8.5M20 4v4.5h-4.5' },
  volume: { d: 'M11 5 6.5 9H3v6h3.5L11 19zM15.5 9a4.5 4.5 0 0 1 0 6M18.5 6a8.5 8.5 0 0 1 0 12' },
  mute: { d: 'M11 5 6.5 9H3v6h3.5L11 19zM16 9.5l5 5M21 9.5l-5 5' },
  headphones: { d: 'M4 18v-5a8 8 0 0 1 16 0v5M20 15v3a2 2 0 0 1-2 2h-1v-6h3M4 15v3a2 2 0 0 0 2 2h1v-6H4' },
  video: { d: 'M3 7a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM15 10.5l6-3.5v10l-6-3.5' },
  external: { d: 'M7 17 17 7M8.5 7H17v8.5' },
  swap: { d: 'M4 8h15M15 4l4 4-4 4M20 16H5M9 12l-4 4 4 4' },
  arrow: { d: 'M5 12h14M13 6l6 6-6 6' },
  expand: { d: 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5' },
  sun: { d: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4' },
  moon: { d: 'M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z' },
  auto: { d: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 3v18' },
} satisfies Record<string, { d: string; fill?: boolean }>;

const { name, class: className } = Astro.props;
const icon = icons[name] as { d: string; fill?: boolean };
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? 'none' : 'currentColor'}
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"><path d={icon.d}></path></svg>
