---
/* Avond als flyerregel: grote datum zoals op de poster, titel, plek en tijd. */
import { eventHref, type EventEntry } from '../lib/content';
import { formatDate, formatDateLong, formatTime } from '../lib/format';
import CoverArt from './CoverArt.astro';

interface Props {
  event: EventEntry;
  setCount?: number;
  headingLevel?: 'h2' | 'h3';
}
const { event, setCount = 0, headingLevel: Heading = 'h3' } = Astro.props;
const { start, end, venue, title, poster, posterAlt } = event.data;
---

<article class="event-card">
  <CoverArt seed={`event-${event.id}`} image={poster} alt={posterAlt ?? ''} class="event-card__art" sizes="10rem" />
  <div class="event-card__body">
    <p class="event-card__date">
      <time datetime={start.toISOString()}>
        <span aria-hidden="true">{formatDate(start)}</span>
        <span class="visually-hidden">{formatDateLong(start)}</span>
      </time>
    </p>
    <Heading class="event-card__title"><a href={eventHref(event.id)}>{title} @ {venue.name}</a></Heading>
    <p class="meta">
      {venue.city} · {formatTime(start)}{end && `–${formatTime(end)}`}
      {setCount > 0 && ` · ${setCount} sets`}
    </p>
  </div>
</article>

<style>
  .event-card {
    position: relative;
    display: grid;
    grid-template-columns: clamp(5rem, 18vw, 9rem) 1fr;
    gap: var(--space-s-l);
    align-items: center;
    padding-block: var(--space-s);
    border-block-end: var(--border-width) solid var(--color-line);
  }
  .event-card__body { display: grid; gap: var(--space-3xs); }
  .event-card__date {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .event-card__title { font-size: var(--step-1); font-family: var(--font-sans); letter-spacing: 0; }
  .event-card__title a { text-decoration: none; }
  /* Hele kaart klikbaar via de titel-link */
  .event-card__title a::after { content: ''; position: absolute; inset: 0; }
  .event-card:hover .event-card__title a { text-decoration: underline; }
  .event-card :global(.art) { transition: scale var(--dur-slow) var(--ease-out); }
  @media (hover: hover) {
    .event-card:hover :global(.art) { scale: 1.04; }
  }
</style>
